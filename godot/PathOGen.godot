; Engine configuration file.
; PathOGen (Godot version). The web version lives elsewhere in this repo.

config_version=5

[application]

config/name="PathOGen"
config/description="Play Grasshopper component cards to build a definition and fight bugs."
run/main_scene="res://scenes/debug_main.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")

[autoload]

GameDB="*res://scripts/autoload/game_db.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
