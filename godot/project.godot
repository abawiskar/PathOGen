; PathOGen, Godot version. Shares levels and component data with ../web.

config_version=5

[application]

config/name="PathOGen"
config/description="Build the Script. Survive the Monster. Master Grasshopper."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[rendering]

anti_aliasing/quality/msaa_2d=2
environment/defaults/default_clear_color=Color(0.043, 0.075, 0.071, 1)
