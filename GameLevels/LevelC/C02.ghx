              </items>
              <chunks count="1">
                <chunk name="Container">
                  <items count="13">
                    <item name="Bold" type_name="gh_bool" type_code="1">false</item>
                    <item name="Ca" type_name="gh_drawing_pointf" type_code="31">
                      <X>3038.462</X>
