                          <W>1174.7148</W>
                          <H>76.46289</H>
                        </item>
                        <item name="Pivot" type_name="gh_drawing_pointf" type_code="31">
                          <X>45</X>
                          <Y>-225</Y>
                        </item>
                      </items>
                    </chunk>
                  </chunks>
                </chunk>
