                      <Y>123.40332</Y>
                    </item>
                    <item name="Description" type_name="gh_string" type_code="10">A quick note</item>
                    <item name="Font" type_name="gh_string" type_code="10">Arial</item>
                    <item name="InstanceGuid" type_name="gh_guid" type_code="9">c130ca46-4877-42dc-b598-31dc51b8522f</item>
                    <item name="Italic" type_name="gh_bool" type_code="1">false</item>
                    <item name="Name" type_name="gh_string" type_code="10">Scribble</item>
                    <item name="NickName" type_name="gh_string" type_code="10">Scribble</item>
                    <item name="Size" type_name="gh_single" type_code="5">9</item>
                    <item name="Text" type_name="gh_string" type_code="10">STEP 2  -  Cut the panels
Goal: one surface patch per grid cell.
Idea: Isotrim trims the skin to each UV cell, so the panels
   follow the twisted surface exactly.
Watch for: The panels are slightly warped because the skin
   twists.</item>
                  </items>
                  <chunks count="1">
                    <chunk name="Attributes">
                      <items count="2">
                        <item name="Bounds" type_name="gh_drawing_rectanglef" type_code="35">
                          <X>4743.462</X>
                          <Y>60</Y>
                          <W>251.29053</W>
                          <H>68.40332</H>
                        </item>
                        <item name="Pivot" type_name="gh_drawing_pointf" type_code="31">
                          <X>4748.462</X>
                          <Y>65</Y>
                        </item>
                      </items>
                    </chunk>
                  </chunks>
                </chunk>
              </chunks>
            </chunk>
            <chunk name="Object" index="76">
              <items count="2">
                <item name="GUID" type_name="gh_guid" type_code="9">7f5c6c55-f846-4a08-9c9a-cfdc285cc6fe</item>
                <item name="Name" type_name="gh_string" type_code="10">Scribble</item>
              </items>
              <chunks count="1">
                <chunk name="Container">
                  <items count="13">
                    <item name="Bold" type_name="gh_bool" type_code="1">false</item>
                    <item name="Ca" type_name="gh_drawing_pointf" type_code="31">
                      <X>5069.7524</X>
                      <Y>65</Y>
                    </item>
                    <item name="Cb" type_name="gh_drawing_pointf" type_code="31">
                      <X>5310.7617</X>
                      <Y>65</Y>
                    </item>
                    <item name="Cc" type_name="gh_drawing_pointf" type_code="31">
                      <X>5310.7617</X>
                      <Y>113.05859</Y>
                    </item>
                    <item name="Cd" type_name="gh_drawing_pointf" type_code="31">
                      <X>5069.7524</X>
                      <Y>113.05859</Y>
                    </item>
                    <item name="Description" type_name="gh_string" type_code="10">A quick note</item>
                    <item name="Font" type_name="gh_string" type_code="10">Arial</item>
                    <item name="InstanceGuid" type_name="gh_guid" type_code="9">cea01b67-54bc-4e01-8cab-f4f3cd55cdcc</item>
                    <item name="Italic" type_name="gh_bool" type_code="1">false</item>
                    <item name="Name" type_name="gh_string" type_code="10">Scribble</item>
                    <item name="NickName" type_name="gh_string" type_code="10">Scribble</item>
                    <item name="Size" type_name="gh_single" type_code="5">9</item>
                    <item name="Text" type_name="gh_string" type_code="10">STEP 3  -  Points on every floor
Goal: N points around every floor outline.
Idea: The outlines are a list, so Divide Curve returns a tree:
   one branch of points per floor, {floor}(point).
Wire check: Panels / mullions around -&gt; N.</item>
                  </items>
                  <chunks count="1">
                    <chunk name="Attributes">
                      <items count="2">
                        <item name="Bounds" type_name="gh_drawing_rectanglef" type_code="35">
                          <X>5064.7524</X>
                          <Y>60</Y>
                          <W>251.00928</W>
                          <H>58.058594</H>
                        </item>
                        <item name="Pivot" type_name="gh_drawing_pointf" type_code="31">
                          <X>5069.7524</X>
                          <Y>65</Y>
                        </item>
                      </items>
                    </chunk>
                  </chunks>
                </chunk>
              </chunks>
            </chunk>
            <chunk name="Object" index="77">
              <items count="2">
                <item name="GUID" type_name="gh_guid" type_code="9">7f5c6c55-f846-4a08-9c9a-cfdc285cc6fe</item>
                <item name="Name" type_name="gh_string" type_code="10">Scribble</item>
              </items>
              <chunks count="1">
                <chunk name="Container">
                  <items count="13">
                    <item name="Bold" type_name="gh_bool" type_code="1">false</item>
                    <item name="Ca" type_name="gh_drawing_pointf" type_code="31">
                      <X>5407.7524</X>
                      <Y>65</Y>
                    </item>
                    <item name="Cb" type_name="gh_drawing_pointf" type_code="31">
                      <X>5653.9165</X>
                      <Y>65</Y>
                    </item>
                    <item name="Cc" type_name="gh_drawing_pointf" type_code="31">
                      <X>5653.9165</X>
                      <Y>135.54102</Y>
                    </item>
                    <item name="Cd" type_name="gh_drawing_pointf" type_code="31">
                      <X>5407.7524</X>
                      <Y>135.54102</Y>
                    </item>
                    <item name="Description" type_name="gh_string" type_code="10">A quick note</item>
                    <item name="Font" type_name="gh_string" type_code="10">Arial</item>
                    <item name="InstanceGuid" type_name="gh_guid" type_code="9">05b1c97a-37b8-4ca7-ae22-f24c8d9ca080</item>
                    <item name="Italic" type_name="gh_bool" type_code="1">false</item>
                    <item name="Name" type_name="gh_string" type_code="10">Scribble</item>
                    <item name="NickName" type_name="gh_string" type_code="10">Scribble</item>
                    <item name="Size" type_name="gh_single" type_code="5">9</item>
                    <item name="Text" type_name="gh_string" type_code="10">STEP 4  -  Swap rows and columns
Goal: branches per vertical line instead of per floor.
Idea: Flip Matrix turns {floor}(point) into {point}(floor): each
   branch now holds one point from every floor, a vertical line
   of points.
Watch for: This is the key data-tree move: the same points,
   grouped differently.</item>
                  </items>
                  <chunks count="1">
                    <chunk name="Attributes">
                      <items count="2">
                        <item name="Bounds" type_name="gh_drawing_rectanglef" type_code="35">
                          <X>5402.7524</X>
                          <Y>60</Y>
                          <W>256.16406</W>
                          <H>80.541016</H>
                        </item>
                        <item name="Pivot" type_name="gh_drawing_pointf" type_code="31">
                          <X>5407.7524</X>
                          <Y>65</Y>
                        </item>
                      </items>
                    </chunk>
                  </chunks>
                </chunk>
              </chunks>
            </chunk>
            <chunk name="Object" index="78">
              <items count="2">
                <item name="GUID" type_name="gh_guid" type_code="9">7f5c6c55-f846-4a08-9c9a-cfdc285cc6fe</item>
                <item name="Name" type_name="gh_string" type_code="10">Scribble</item>
              </items>
              <chunks count="1">
                <chunk name="Container">
                  <items count="13">
                    <item name="Bold" type_name="gh_bool" type_code="1">false</item>
                    <item name="Ca" type_name="gh_drawing_pointf" type_code="31">
                      <X>5733.9165</X>
                      <Y>65</Y>
                    </item>
                    <item name="Cb" type_name="gh_drawing_pointf" type_code="31">
                      <X>5978.16</X>
                      <Y>65</Y>
                    </item>
                    <item name="Cc" type_name="gh_drawing_pointf" type_code="31">
                      <X>5978.16</X>
                      <Y>123.40332</Y>
                    </item>
                    <item name="Cd" type_name="gh_drawing_pointf" type_code="31">
                      <X>5733.9165</X>
                      <Y>123.40332</Y>
                    </item>
                    <item name="Description" type_name="gh_string" type_code="10">A quick note</item>
                    <item name="Font" type_name="gh_string" type_code="10">Arial</item>
                    <item name="InstanceGuid" type_name="gh_guid" type_code="9">1f3ad9a2-982c-42db-9735-0a56bf32239d</item>
                    <item name="Italic" type_name="gh_bool" type_code="1">false</item>
                    <item name="Name" type_name="gh_string" type_code="10">Scribble</item>
                    <item name="NickName" type_name="gh_string" type_code="10">Scribble</item>
                    <item name="Size" type_name="gh_single" type_code="5">9</item>
                    <item name="Text" type_name="gh_string" type_code="10">STEP 5  -  Curves up the tower
Goal: one smooth curve through each column of points.
Idea: Interpolate draws a curve through every branch: one
   twisting mullion per column.
Watch for: Without Flip Matrix you'd get curves around each
   floor instead.</item>
                  </items>
                  <chunks count="1">
                    <chunk name="Attributes">
                      <items count="2">
                        <item name="Bounds" type_name="gh_drawing_rectanglef" type_code="35">
                          <X>5728.9165</X>
                          <Y>60</Y>
                          <W>254.24365</W>
                          <H>68.40332</H>
                        </item>
                        <item name="Pivot" type_name="gh_drawing_pointf" type_code="31">
                          <X>5733.9165</X>
                          <Y>65</Y>
                        </item>
                      </items>
                    </chunk>
                  </chunks>
                </chunk>
              </chunks>
            </chunk>
            <chunk name="Object" index="79">
